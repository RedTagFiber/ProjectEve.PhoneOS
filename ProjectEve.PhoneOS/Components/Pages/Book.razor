@page "/book"

<PageTitle>Book</PageTitle>

<div class="phone-stage">
    <div class="phone-bezel">
        <div class="phone-notch"></div>

        <div class="phone-screen book-screen">
            <div class="status-bar">
                <span>@DateTime.Now.ToString("h:mm")</span>
                <span>5G · 84%</span>
            </div>

            <div class="book-top">
                <a class="book-back" href="/">‹</a>
                <div class="book-brand">Book</div>
                <button type="button" class="book-icon-btn" title="Search">⌕</button>
            </div>

            @* Composer *@
            <div class="book-composer-card">
                <img class="book-avatar" src="@_playerPortrait" alt="You" />
                <div class="book-composer-fake">What's on your mind?</div>
            </div>

            @* Quick actions *@
            <div class="book-quick">
                <span>📷 Photo</span>
                <span>📍 Check in</span>
                <span>😊 Feeling</span>
            </div>

            @* Feed *@
            <div class="book-feed">
                @foreach (var post in _posts)
                {
                    <article class="book-post">
                        <header class="bp-head">
                            <img class="book-avatar" src="@post.Avatar" alt="@post.Name" />
                            <div class="bp-meta">
                                <div class="bp-name">@post.Name</div>
                                <div class="bp-sub">@post.Time · @post.Place</div>
                            </div>
                            <button type="button" class="bp-more">•••</button>
                        </header>

                        <p class="bp-text">@post.Text</p>

                        @if (!string.IsNullOrWhiteSpace(post.Image))
                        {
                            <div class="bp-image" style="background-image: url('@post.Image');"></div>
                        }

                        <div class="bp-stats">
                            <span>👍 @post.Likes</span>
                            <span>@post.Comments comments</span>
                        </div>

                        <div class="bp-actions">
                            <button type="button" class="@(post.Liked ? "on" : null)" @onclick="() => ToggleLike(post)">Like</button>
                            <button type="button">Comment</button>
                            <button type="button">Share</button>
                        </div>
                    </article>
                }
            </div>

            <div class="home-indicator"></div>
        </div>
    </div>
</div>

@code {
    string _playerPortrait = "/images/npcs/eve/portraits/eve_hoodie.jpg";

    readonly List<FbPost> _posts = new()
    {
        new(
            "Eve",
            "/images/npcs/eve/portraits/eve_hoodie.jpg",
            "Coffee Shop",
            "2h",
            "Closing shift felt longer than usual. Still love the quiet after everyone leaves.",
            "/images/scenes/coffee-shop.png",
            24,
            3,
            false),
        new(
            "Eve",
            "/images/npcs/eve/portraits/eve_nightlife.jpg",
            "Bellefontaine",
            "Yesterday",
            "Out for a bit. Needed the noise.",
            "/images/scenes/eve-apartment.png",
            56,
            8,
            true),
        new(
            "Eve",
            "/images/npcs/eve/portraits/eve_sundress.jpg",
            "Near town",
            "3d",
            "Sun finally showed up. Took the long way home.",
            null,
            41,
            5,
            false),
    };

    void ToggleLike(FbPost post)
    {
        post.Liked = !post.Liked;
        post.Likes += post.Liked ? 1 : -1;
    }

    sealed class FbPost
    {
        public string Name { get; }
        public string Avatar { get; }
        public string Place { get; }
        public string Time { get; }
        public string Text { get; }
        public string? Image { get; }
        public int Likes { get; set; }
        public int Comments { get; }
        public bool Liked { get; set; }

        public FbPost(string name, string avatar, string place, string time, string text, string? image, int likes, int comments, bool liked)
        {
            Name = name; Avatar = avatar; Place = place; Time = time;
            Text = text; Image = image; Likes = likes; Comments = comments; Liked = liked;
        }
    }
}

<style>
