@page "/gram"

<PageTitle>Gram</PageTitle>

<div class="phone-stage">
    <div class="phone-bezel">
        <div class="phone-notch"></div>

        <div class="phone-screen gram-screen">
            <div class="status-bar">
                <span>@DateTime.Now.ToString("h:mm")</span>
                <span>5G · 84%</span>
            </div>

            <div class="gram-top">
                <a class="gram-back" href="/">‹</a>
                <div class="gram-brand">Gram</div>
                <button type="button" class="gram-icon-btn" title="Activity">♡</button>
            </div>

            @* Stories *@
            <div class="gram-stories">
                <div class="story you">
                    <div class="story-ring">
                        <img src="@_playerPortrait" alt="You" />
                    </div>
                    <span>Your story</span>
                </div>
                @foreach (var s in _stories)
                {
                    <div class="story">
                        <div class="story-ring live">
                            <img src="@s.Avatar" alt="@s.Name" />
                        </div>
                        <span>@s.Name</span>
                    </div>
                }
            </div>

            @* Feed *@
            <div class="gram-feed">
                @foreach (var post in _posts)
                {
                    <article class="gram-post">
                        <header class="post-head">
                            <img class="post-avatar" src="@post.Avatar" alt="@post.Name" />
                            <div class="post-meta">
                                <div class="post-name">@post.Name</div>
                                <div class="post-place">@post.Place</div>
                            </div>
                            <button type="button" class="post-more">•••</button>
                        </header>

                        <div class="post-image" style="background-image: url('@post.Image');"></div>

                        <div class="post-actions">
                            <button type="button" class="@(post.Liked ? "liked" : null)" @onclick="() => ToggleLike(post)">♡</button>
                            <button type="button">💬</button>
                            <button type="button">➤</button>
                            <button type="button" class="save">☆</button>
                        </div>

                        <div class="post-likes">@post.Likes.ToString("N0") likes</div>
                        <div class="post-caption">
                            <strong>@post.Name</strong> @post.Caption
                        </div>
                        <div class="post-time">@post.Time</div>
                    </article>
                }
            </div>

            <div class="home-indicator"></div>
        </div>
    </div>
</div>

@code {
    string _playerPortrait = "/images/npcs/eve/portraits/eve_hoodie.jpg";

    readonly List<Story> _stories = new()
    {
        new("Eve", "/images/npcs/eve/portraits/eve_hoodie.jpg"),
        new("Eve", "/images/npcs/eve/portraits/eve_nightlife.jpg"),
        new("Eve", "/images/npcs/eve/portraits/eve_sundress.jpg"),
    };

    readonly List<Post> _posts = new()
    {
        new(
            "Eve",
            "/images/npcs/eve/portraits/eve_hoodie.jpg",
            "/images/scenes/eve-apartment.png",
            "Eve's Apartment",
            "Quiet night in. Candle still going.",
            "2 hours ago",
            128,
            false),
        new(
            "Eve",
            "/images/npcs/eve/portraits/Eve_SinClaire_Portait.png",
            "/images/scenes/coffee-shop.png",
            "Downtown · Bellefontaine",
            "Shift’s over. Sun through the glass is always the best part.",
            "Yesterday",
            342,
            true),
    };

    void ToggleLike(Post post)
    {
        post.Liked = !post.Liked;
        post.Likes += post.Liked ? 1 : -1;
    }

    sealed record Story(string Name, string Avatar);

    sealed class Post
    {
        public string Name { get; }
        public string Avatar { get; }
        public string Image { get; }
        public string Place { get; }
        public string Caption { get; }
        public string Time { get; }
        public int Likes { get; set; }
        public bool Liked { get; set; }

        public Post(string name, string avatar, string image, string place, string caption, string time, int likes, bool liked)
        {
            Name = name; Avatar = avatar; Image = image; Place = place;
            Caption = caption; Time = time; Likes = likes; Liked = liked;
        }
    }
}

<style>
    .phone-stage {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.25rem;
        background: radial-gradient(ellipse at 50% 0%, #1a1a28 0%, #07070a 55%);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }

    .phone-bezel {
        width: min(390px, 100%);
        border-radius: 42px;
        padding: 10px;
        background: linear-gradient(160deg, #3a3a40 0%, #1c1c1e 40%, #0e0e10 100%);
        box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 25px 50px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.12);
        position: relative;
    }

    .phone-notch {
        position: absolute;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        width: 110px;
        height: 28px;
        background: #000;
        border-radius: 20px;
        z-index: 5;
    }

    .gram-screen {
        border-radius: 34px;
        overflow: hidden;
        min-height: 720px;
        height: min(780px, 92vh);
        background: #000;
        color: #f5f5f7;
        display: flex;
        flex-direction: column;
    }

    .status-bar {
        display: flex;
        justify-content: space-between;
        padding: 0.85rem 1.35rem 0.2rem;
        font-size: 0.78rem;
        font-weight: 600;
        opacity: 0.92;
    }

    .gram-top {
        display: flex;
        align-items: center;
        padding: 0.25rem 0.85rem 0.55rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .gram-back {
        color: #f5f5f7;
        text-decoration: none;
        font-size: 1.5rem;
        width: 2rem;
    }

    .gram-brand {
        flex: 1;
        text-align: center;
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
        background: linear-gradient(120deg, #ff7ab8, #c44bff, #5e5ce6);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .gram-icon-btn {
        width: 2rem;
        border: none;
        background: transparent;
        color: #f5f5f7;
        font-size: 1.15rem;
        cursor: pointer;
    }

    .gram-stories {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem 0.85rem;
        overflow-x: auto;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .story {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        min-width: 64px;
        font-size: 0.62rem;
        opacity: 0.9;
    }

    .story-ring {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        padding: 2px;
        background: #3a3a3c;
    }

        .story-ring.live {
            background: linear-gradient(135deg, #ff7ab8, #c44bff, #ff9f0a);
        }

        .story-ring img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #000;
        }

    .gram-feed {
        flex: 1;
        overflow-y: auto;
    }

    .gram-post {
        padding-bottom: 1rem;
    }

    .post-head {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 0.85rem;
    }

    .post-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
    }

    .post-meta {
        flex: 1;
        min-width: 0;
    }

    .post-name {
        font-weight: 600;
        font-size: 0.85rem;
    }

    .post-place {
        font-size: 0.68rem;
        opacity: 0.55;
    }

    .post-more {
        border: none;
        background: transparent;
        color: #f5f5f7;
        font-size: 1rem;
        cursor: pointer;
    }

    .post-image {
        width: 100%;
        aspect-ratio: 1;
        background-size: cover;
        background-position: center;
        background-color: #1c1c1e;
    }

    .post-actions {
        display: flex;
        gap: 0.85rem;
        padding: 0.55rem 0.85rem 0.25rem;
    }

        .post-actions button {
            border: none;
            background: transparent;
            color: #f5f5f7;
            font-size: 1.25rem;
            cursor: pointer;
            padding: 0;
        }

            .post-actions button.liked {
                color: #ff453a;
            }

        .post-actions .save {
            margin-left: auto;
        }

    .post-likes {
        padding: 0 0.85rem;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .post-caption {
        padding: 0.2rem 0.85rem 0;
        font-size: 0.85rem;
        line-height: 1.35;
    }

        .post-caption strong {
            margin-right: 0.3rem;
        }

    .post-time {
        padding: 0.25rem 0.85rem 0;
        font-size: 0.65rem;
        opacity: 0.45;
        text-transform: uppercase;
    }

    .home-indicator {
        width: 120px;
        height: 4px;
        border-radius: 4px;
        background: rgba(255,255,255,0.35);
        margin: 0.55rem auto 0.5rem;
    }
</style>