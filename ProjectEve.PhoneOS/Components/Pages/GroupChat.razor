@page "/group"

<PageTitle>Groups</PageTitle>

<div class="phone-stage">
    <div class="phone-bezel">
        <div class="phone-notch"></div>

        <div class="phone-screen group-screen">
            <div class="status-bar">
                <span>@DateTime.Now.ToString("h:mm")</span>
                <span>5G · 84%</span>
            </div>

            @if (_active == null)
            {
                @* LIST *@
                <div class="grp-top">
                    <a class="grp-back" href="/">‹</a>
                    <div class="grp-brand">Groups</div>
                    <button type="button" class="grp-icon-btn" title="New">＋</button>
                </div>

                <div class="grp-list">
                    @foreach (var g in _groups)
                    {
                        <button type="button" class="grp-row" @onclick="() => Open(g)">
                            <div class="grp-avatars">
                                @foreach (var av in g.Avatars.Take(3))
                                {
                                    <img src="@av" alt="" />
                                }
                            </div>
                            <div class="grp-meta">
                                <div class="grp-name">
                                    @g.Name
                                    @if (g.Unread > 0)
                                    {
                                        <span class="grp-badge">@g.Unread</span>
                                    }
                                </div>
                                <div class="grp-preview">@g.Preview</div>
                            </div>
                            <div class="grp-time">@g.Time</div>
                        </button>
                    }
                </div>
            }
            else
            {
                @* THREAD *@
                <div class="grp-top">
                    <button type="button" class="grp-back btn" @onclick="Close">‹</button>
                    <div class="grp-thread-title">
                        <div class="grp-name">@_active.Name</div>
                        <div class="grp-sub">@_active.Members</div>
                    </div>
                    <button type="button" class="grp-icon-btn">ⓘ</button>
                </div>

                <div class="grp-thread">
                    @foreach (var m in _active.Messages)
                    {
                        <div class="gmsg @(m.Mine ? "me" : "them")">
                            @if (!m.Mine)
                            {
                                <img class="gmsg-av" src="@m.Avatar" alt="@m.Sender" />
                            }
                            <div class="gmsg-col">
                                @if (!m.Mine)
                                {
                                    <div class="gmsg-sender">@m.Sender</div>
                                }
                                <div class="gmsg-bubble">@m.Text</div>
                                <div class="gmsg-time">@m.Time</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="grp-composer">
                    <input class="grp-input"
                           @bind="_draft"
                           @bind:event="oninput"
                           @onkeydown="OnKey"
                           placeholder="Message @_active.Name" />
                    <button type="button" class="grp-send" @onclick="Send">↑</button>
                </div>
            }

            <div class="home-indicator"></div>
        </div>
    </div>
</div>

@code {
    string _draft = "";
    GroupChatModel? _active;

    readonly List<GroupChatModel> _groups = new()
    {
        new(
            "coffee-crew",
            "Coffee Crew",
            "Eve, Sam, you",
            "Eve: Closing early if it’s dead",
            "9:12 PM",
            2,
            new[]
            {
                "/images/npcs/eve/portraits/eve_hoodie.jpg",
                "/images/npcs/eve/portraits/eve_nightlife.jpg",
            },
            new List<GMsg>
            {
                new(false, "Eve", "/images/npcs/eve/portraits/eve_hoodie.jpg", "Anyone still coming by?", "8:58 PM"),
                new(true, "You", "", "I can in 20.", "9:01 PM"),
                new(false, "Eve", "/images/npcs/eve/portraits/eve_hoodie.jpg", "Closing early if it’s dead", "9:12 PM"),
            }),
        new(
            "osu-watch",
            "OSU Watch",
            "Ryan house · 6 people",
            "Sam: Bring chips",
            "Yesterday",
            0,
            new[]
            {
                "/images/npcs/eve/portraits/eve_sundress.jpg",
                "/images/npcs/eve/portraits/eve_hoodie.jpg",
            },
            new List<GMsg>
            {
                new(false, "Sam", "/images/npcs/eve/portraits/eve_sundress.jpg", "Bring chips", "Yesterday"),
                new(true, "You", "", "On it.", "Yesterday"),
            }),
        new(
            "family-thread",
            "Family",
            "Mom, Dad, you",
            "Mom: Call when you can",
            "Mon",
            1,
            new[]
            {
                "/images/npcs/eve/portraits/Eve_SinClaire_Portait.png",
            },
            new List<GMsg>
            {
                new(false, "Mom", "/images/npcs/eve/portraits/Eve_SinClaire_Portait.png", "Call when you can", "Mon"),
            }),
    };

    void Open(GroupChatModel g)
    {
        _active = g;
        g.Unread = 0;
    }

    void Close() => _active = null;

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    async Task Send()
    {
        if (_active == null) return;
        var text = _draft?.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;

        _active.Messages.Add(new GMsg(true, "You", "", text, DateTime.Now.ToString("h:mm tt")));
        _active.Preview = $"You: {text}";
        _active.Time = "now";
        _draft = "";
        await Task.CompletedTask;
    }

    sealed class GroupChatModel
    {
        public string Id { get; }
        public string Name { get; }
        public string Members { get; }
        public string Preview { get; set; }
        public string Time { get; set; }
        public int Unread { get; set; }
        public string[] Avatars { get; }
        public List<GMsg> Messages { get; }

        public GroupChatModel(string id, string name, string members, string preview, string time, int unread, string[] avatars, List<GMsg> messages)
        {
            Id = id; Name = name; Members = members; Preview = preview;
            Time = time; Unread = unread; Avatars = avatars; Messages = messages;
        }
    }

    sealed record GMsg(bool Mine, string Sender, string Avatar, string Text, string Time);
}

<style>
    .phone-stage {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.25rem;
        background: radial-gradient(ellipse at 50% 0%, #1a1a28 0%, #07070a 55%);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }

    .phone-bezel {
        width: min(390px, 100%);
        border-radius: 42px;
        padding: 10px;
        background: linear-gradient(160deg, #3a3a40 0%, #1c1c1e 40%, #0e0e10 100%);
        box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 25px 50px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.12);
        position: relative;
    }

    .phone-notch {
        position: absolute;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        width: 110px;
        height: 28px;
        background: #000;
        border-radius: 20px;
        z-index: 5;
    }

    .group-screen {
        border-radius: 34px;
        overflow: hidden;
        min-height: 720px;
        height: min(780px, 92vh);
        background: #000;
        color: #f5f5f7;
        display: flex;
        flex-direction: column;
    }

    .status-bar {
        display: flex;
        justify-content: space-between;
        padding: 0.85rem 1.35rem 0.2rem;
        font-size: 0.78rem;
        font-weight: 600;
        opacity: 0.92;
    }

    .grp-top {
        display: flex;
        align-items: center;
        padding: 0.25rem 0.85rem 0.55rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .grp-back {
        color: #0a84ff;
        text-decoration: none;
        font-size: 1.5rem;
        width: 2rem;
        background: none;
        border: none;
        cursor: pointer;
        text-align: left;
        padding: 0;
    }

        .grp-back.btn {
            color: #0a84ff;
        }

    .grp-brand {
        flex: 1;
        text-align: center;
        font-weight: 800;
        font-size: 1.1rem;
        background: linear-gradient(120deg, #64d2ff, #0a84ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .grp-thread-title {
        flex: 1;
        text-align: center;
    }

        .grp-thread-title .grp-name {
            font-weight: 700;
            font-size: 0.95rem;
        }

    .grp-sub {
        font-size: 0.68rem;
        opacity: 0.5;
    }

    .grp-icon-btn {
        width: 2rem;
        border: none;
        background: transparent;
        color: #f5f5f7;
        font-size: 1.2rem;
        cursor: pointer;
    }

    .grp-list {
        flex: 1;
        overflow-y: auto;
    }

    .grp-row {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.75rem 0.9rem;
        border: none;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        background: transparent;
        color: #f5f5f7;
        text-align: left;
        cursor: pointer;
    }

        .grp-row:hover {
            background: rgba(255,255,255,0.04);
        }

    .grp-avatars {
        display: flex;
        width: 48px;
        height: 36px;
        position: relative;
        flex-shrink: 0;
    }

        .grp-avatars img {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #000;
            position: absolute;
            top: 4px;
        }

            .grp-avatars img:nth-child(1) {
                left: 0;
                z-index: 2;
            }

            .grp-avatars img:nth-child(2) {
                left: 14px;
                z-index: 1;
            }

            .grp-avatars img:nth-child(3) {
                left: 28px;
                z-index: 0;
            }

    .grp-meta {
        flex: 1;
        min-width: 0;
    }

    .grp-name {
        font-weight: 700;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .grp-badge {
        font-size: 0.65rem;
        font-weight: 700;
        background: #0a84ff;
        color: #fff;
        border-radius: 999px;
        padding: 0.05rem 0.4rem;
    }

    .grp-preview {
        font-size: 0.78rem;
        opacity: 0.5;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 0.15rem;
    }

    .grp-time {
        font-size: 0.68rem;
        opacity: 0.4;
        flex-shrink: 0;
    }

    .grp-thread {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .gmsg {
        display: flex;
        align-items: flex-end;
        gap: 0.4rem;
        max-width: 90%;
    }

        .gmsg.them {
            align-self: flex-start;
        }

        .gmsg.me {
            align-self: flex-end;
        }

    .gmsg-av {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .gmsg-col {
        display: flex;
        flex-direction: column;
    }

    .gmsg.me .gmsg-col {
        align-items: flex-end;
    }

    .gmsg-sender {
        font-size: 0.65rem;
        font-weight: 600;
        opacity: 0.55;
        margin-bottom: 0.12rem;
        padding-left: 0.25rem;
    }

    .gmsg-bubble {
        padding: 0.5rem 0.75rem;
        border-radius: 16px;
        font-size: 0.9rem;
        line-height: 1.35;
        background: #1c1c1e;
    }

    .gmsg.them .gmsg-bubble {
        border-bottom-left-radius: 5px;
    }

    .gmsg.me .gmsg-bubble {
        background: linear-gradient(160deg, #2f8fff, #0a84ff);
        border-bottom-right-radius: 5px;
    }

    .gmsg-time {
        font-size: 0.6rem;
        opacity: 0.4;
        margin-top: 0.15rem;
        padding: 0 0.2rem;
    }

    .grp-composer {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0 0.65rem;
        padding: 0.4rem;
        border-radius: 24px;
        background: rgba(28,28,32,0.95);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .grp-input {
        flex: 1;
        border: none;
        background: transparent;
        color: #f5f5f7;
        outline: none;
        font-size: 0.92rem;
        min-width: 0;
    }

    .grp-send {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(160deg, #2f8fff, #0a84ff);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

    .home-indicator {
        width: 120px;
        height: 4px;
        border-radius: 4px;
        background: rgba(255,255,255,0.35);
        margin: 0.55rem auto 0.5rem;
    }
</style>