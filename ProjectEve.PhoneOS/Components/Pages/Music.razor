@page "/music"

<PageTitle>Music</PageTitle>

<div class="phone-stage">
    <div class="phone-bezel">
        <div class="phone-notch"></div>

        <div class="phone-screen music-screen">
            <div class="status-bar">
                <span>@DateTime.Now.ToString("h:mm")</span>
                <span>5G · 84%</span>
            </div>

            <div class="music-top">
                <a class="music-back" href="/">‹</a>
                <div class="music-brand">Music</div>
                <button type="button" class="music-icon-btn" title="Library">☰</button>
            </div>

            @* Now playing card *@
            <div class="now-card">
                <div class="now-art" style="background-image: url('@_current.Art');"></div>
                <div class="now-info">
                    <div class="now-title">@_current.Title</div>
                    <div class="now-artist">@_current.Artist</div>
                    <div class="now-tag">@_current.MoodTag</div>
                </div>

                <div class="now-progress">
                    <div class="now-bar"><span style="width:@_progress%"></span></div>
                    <div class="now-times"><span>@_elapsed</span><span>@_duration</span></div>
                </div>

                <div class="now-controls">
                    <button type="button" @onclick="Prev">⏮</button>
                    <button type="button" class="play" @onclick="TogglePlay">@(_playing ? "⏸" : "▶")</button>
                    <button type="button" @onclick="Next">⏭</button>
                </div>
            </div>

            @* Mood beds (Thought musicTag later) *@
            <div class="section-label">Mood beds</div>
            <div class="mood-row">
                @foreach (var m in _moods)
                {
                    <button type="button"
                            class="mood-chip @(m == _activeMood ? "active" : null)"
                            @onclick="() => SelectMood(m)">
                        @m
                    </button>
                }
            </div>

            @* Queue / library list *@
            <div class="section-label">Up next</div>
            <div class="track-list">
                @foreach (var t in _tracks)
                {
                    <button type="button" class="track-row @(_current.Id == t.Id ? "current" : null)" @onclick="() => Play(t)">
                        <div class="track-art" style="background-image: url('@t.Art');"></div>
                        <div class="track-meta">
                            <div class="track-title">@t.Title</div>
                            <div class="track-sub">@t.Artist · @t.MoodTag</div>
                        </div>
                        <div class="track-dur">@t.Duration</div>
                    </button>
                }
            </div>

            <div class="home-indicator"></div>
        </div>
    </div>
</div>

@code {
    bool _playing;
    int _progress = 35;
    string _elapsed = "1:12";
    string _duration = "3:24";
    string _activeMood = "Comfort";

    readonly string[] _moods = { "Fight", "Romantic", "Jealous", "Comfort", "Lonely", "Desire", "Drive", "Club", "Reggae" };

    readonly List<Track> _tracks = new()
    {
        new("1", "Quiet Hours", "Local Bed", "Comfort", "3:24", "/images/scenes/eve-apartment.png"),
        new("2", "Wet Sidewalk", "Local Bed", "Lonely", "2:58", "/images/scenes/coffee-shop.png"),
        new("3", "After Midnight", "Local Bed", "Desire", "3:41", "/images/scenes/ryans-house.png"),
        new("4", "Dashboard Glow", "Local Bed", "Drive", "4:02", "/images/scenes/ryans-house.png"),
        new("5", "Low Light", "Local Bed", "Romantic", "3:15", "/images/scenes/eve-apartment.png"),
    };

    Track _current = null!;

    protected override void OnInitialized()
    {
        _current = _tracks[0];
    }

    void Play(Track t)
    {
        _current = t;
        _playing = true;
        _progress = 0;
        _elapsed = "0:00";
        _duration = t.Duration;
        _activeMood = t.MoodTag;
    }

    void TogglePlay() => _playing = !_playing;

    void Next()
    {
        var i = _tracks.FindIndex(t => t.Id == _current.Id);
        Play(_tracks[(i + 1) % _tracks.Count]);
    }

    void Prev()
    {
        var i = _tracks.FindIndex(t => t.Id == _current.Id);
        Play(_tracks[(i - 1 + _tracks.Count) % _tracks.Count]);
    }

    void SelectMood(string mood)
    {
        _activeMood = mood;
        var hit = _tracks.FirstOrDefault(t => t.MoodTag == mood);
        if (hit != null) Play(hit);
    }

    sealed record Track(string Id, string Title, string Artist, string MoodTag, string Duration, string Art);
}

<style>
